[Unit]
Description=Meshpoint
Documentation=https://github.com/javastraat/meshpoint
After=network-online.target
Wants=network-online.target
# Ordering only, deliberately no Wants=/Requires= -- rnsd.service is an
# opt-in companion installed by the reticulum plugin's setup.sh, not by
# default. Meshpoint's core function has nothing to do with Reticulum and
# must start and run fine whether or not rnsd.service exists, is enabled,
# or fails (a plugin service that fails to start is logged and skipped) --
# this line only affects boot order on installs where both happen to be
# active, so the reticulum plugin's client doesn't race rnsd's own startup.
After=rnsd.service

[Service]
Type=simple
User=meshpoint
Group=meshpoint
WorkingDirectory=/opt/meshpoint
ExecStartPre=+/bin/bash -c "cp /opt/meshpoint/config/sudoers-meshpoint /etc/sudoers.d/meshpoint && chmod 440 /etc/sudoers.d/meshpoint"
# Recursive, whole tree: the service user owns the entire install.
# Covers config/ and data/, the WorkingDirectory itself (lgpio's fan
# notification pipe .lgd-nfyN needs it), AND .git/ — the dashboard's
# apply chain runs `sudo git fetch/reset`, which leaves root-owned
# files in .git and the working tree; every apply ends in a service
# restart, so this line self-heals ownership and plain-git update
# checks keep working.
ExecStartPre=+/bin/chown -R meshpoint:meshpoint /opt/meshpoint
ExecStartPre=+/bin/bash /opt/meshpoint/scripts/reset_concentrator.sh
# Bind host/port come from dashboard.host/dashboard.port in the YAML config
ExecStart=/opt/meshpoint/venv/bin/python -m src.serve
ExecStopPost=+/bin/bash /opt/meshpoint/scripts/reset_concentrator.sh --hold
TimeoutStopSec=10
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meshpoint

Environment=CONCENTRATOR_CONFIG=/opt/meshpoint/config/local.yaml
Environment=PYTHONUNBUFFERED=1
Environment=FORCE_COLOR=1
# arduino-cli's build cache has no --config-file key of its own -- it
# always resolves via $XDG_CACHE_HOME (else $HOME/.cache), and this
# service's `meshpoint` user has no real $HOME (--no-create-home).
# Points it at the same self-contained toolchain dir install.sh sets up
# (see its "Install arduino-cli" section) so a firmware-flash feature
# invoked from this process can actually compile.
Environment=XDG_CACHE_HOME=/opt/arduino-cli/cache
# Same reasoning as XDG_CACHE_HOME above, for the separate PlatformIO
# toolchain (Reticulum companion firmware, see install.sh's "Install
# PlatformIO" section): PLATFORMIO_CORE_DIR is where `pio` stores its
# own downloaded platform/toolchain packages, and defaults to a
# $HOME-relative path this --no-create-home user doesn't have.
Environment=PLATFORMIO_CORE_DIR=/opt/platformio/core

# Hardening
NoNewPrivileges=false
ProtectSystem=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
