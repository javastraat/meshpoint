# sudoers grants for the `meshpoint` service account.
#
# The meshpoint user runs as a least-privilege system account (no login
# shell, no password). The dashboard exposes a curated set of admin
# operations (service control, self-update, post-update migrations)
# that need root; each is enumerated here with NOPASSWD so the service
# can shell out without an interactive prompt.
#
# Path discipline: every command is pinned to its absolute path. Sudo
# matches the literal argv, so wildcards only relax the trailing args
# (branch names, package names, commit SHAs) -- never the binary.

# ── Service management ────────────────────────────────────────────────
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/systemctl status meshpoint *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart meshpoint
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop meshpoint
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/systemctl daemon-reload

# rnsd release/reconnect around an RNode firmware flash (see
# rnode_firmware_routes.py) -- rnsd holds the RNode's serial port open
# continuously as its own live interface, which conflicts with
# rnodeconf needing exclusive access to flash. Scoped to rnsd only,
# same NOPASSWD shape as meshpoint's own service-control lines above.
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop rnsd
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/systemctl start rnsd
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active rnsd
# "Restart rnsd" button on Configuration -> Reticulum, applying saved
# RNode/backbone settings by re-running write_rnsd_config.py (rnsd's
# own ExecStartPre) without a full meshpoint restart.
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart rnsd

# ── Self-update apply chain (Settings → Updates) ──────────────────────
# /opt/meshpoint is owned by root, so all repo mutations need sudo.
# Branch arg is wildcarded so any release channel (main, rc-074,
# custom branch) can be checked out.
# Each rule has a second form with the literal
# `-c safe.directory=/opt/meshpoint` prefix: the dashboard passes it on
# every git call to survive the dubious-ownership check, and sudo
# matches argv exactly, so the prefixed form must be enumerated too.
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git fetch origin *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git -c safe.directory=/opt/meshpoint fetch origin *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git checkout *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git -c safe.directory=/opt/meshpoint checkout *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git pull origin *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git -c safe.directory=/opt/meshpoint pull origin *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git reset --hard *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git -c safe.directory=/opt/meshpoint reset --hard *

# Read-only git ops that hit the dubious-ownership check on the
# root-owned tree; the terminal catalog surfaces these as buttons.
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git status
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git -c safe.directory=/opt/meshpoint status
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git log *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git -c safe.directory=/opt/meshpoint log *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git rev-list *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git -c safe.directory=/opt/meshpoint rev-list *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git rev-parse HEAD
# Settings → Updates install_status (read branch + SHA from root-owned tree)
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git rev-parse *
meshpoint ALL=(ALL) NOPASSWD: /usr/bin/git -c safe.directory=/opt/meshpoint rev-parse *

# ── Plugin system deps (meshpoint plugin setup <id> / manual `sudo bash
#    plugins/apps/<id>/setup.sh`) ──────────────────────────────────────
# Wildcarded on the plugin id and tier, unlike every other line in this
# file which pins the exact binary -- deliberate: a plugin's own setup.sh
# is only ever consulted once that plugin is explicitly enabled
# (plugins.<id>.enabled), at which point it already runs arbitrary Python
# in-process with the service's full privileges anyway (see docs/PLUGINS.md
# and README.md's "Plugins" section), so this grant doesn't raise the bar
# beyond what enabling a plugin at all already means. Covers both tiers:
# built-in (src/plugins/apps/) and community drop-ins (plugins/apps/).
meshpoint ALL=(ALL) NOPASSWD: /bin/bash /opt/meshpoint/plugins/apps/*/setup.sh
meshpoint ALL=(ALL) NOPASSWD: /bin/bash /opt/meshpoint/src/plugins/apps/*/setup.sh

# ── Post-update hooks ─────────────────────────────────────────────────
meshpoint ALL=(ALL) NOPASSWD: /opt/meshpoint/venv/bin/pip install *
meshpoint ALL=(ALL) NOPASSWD: /bin/bash /opt/meshpoint/scripts/install.sh
meshpoint ALL=(ALL) NOPASSWD: /bin/bash /opt/meshpoint/scripts/apply_finish.sh
meshpoint ALL=(ALL) NOPASSWD: /bin/bash /opt/meshpoint/scripts/launch_restore_finish.sh *
meshpoint ALL=(ALL) NOPASSWD: /bin/bash /opt/meshpoint/scripts/restore_finish.sh *
meshpoint ALL=(ALL) NOPASSWD: /bin/bash /opt/meshpoint/scripts/post_update.sh
