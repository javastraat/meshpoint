# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.eggs/
*/settings.json

# Virtual environments
venv/
.venv/
env/

# IDE
.cursor/
.vscode/
.idea/
*.swp
*.swo

# Data (repo-root runtime dir only -- unanchored would also swallow any
# future frontend/**/data/ used for static assets, e.g. frontend/data/)
/data/
*.db

# User-specific config (contains API keys)
config/local.yaml

# Generated by scripts/dab_channel_scan.py, not source
config/dab_channel_scan.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Testing
.pytest_cache/
htmlcov/
.coverage

# Misc
*.log

# Temp commit message files
COMMIT_MSG.txt

# Playwright test screenshots (root-only, frontend assets are safe)
/desktop-*.png
/mobile-*.png

# Playwright MCP session artifacts
.playwright-mcp/
/nodeinfo-*.png

# v0.7.x session scratch (paramiko probes, playwright runners, etc.)
scripts/_*
/*.py
/thermal/*


# Ruff cache
.ruff_cache/
.claude/

# WiFi/OTA credentials for the rfenv_companion Arduino sketch -- never commit
*/secrets.h
secrets.h
testplan-*.*

